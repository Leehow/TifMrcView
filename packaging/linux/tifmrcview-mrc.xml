<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-mrc">
    <comment>MRC electron microscopy image</comment>
    <glob pattern="*.mrc"/>
    <glob pattern="*.mrcs"/>
    <glob pattern="*.rec"/>
    <glob pattern="*.st"/>
    <glob pattern="*.map"/>
    <glob pattern="*.ali"/>
    <glob pattern="*.preali"/>
  </mime-type>
  <mime-type type="application/x-czi">
    <comment>Zeiss CZI microscopy image</comment>
    <glob pattern="*.czi"/>
    <magic priority="60">
      <match type="string" offset="0" value="ZISRAWFILE"/>
    </magic>
  </mime-type>
  <mime-type type="application/x-zeiss-lsm">
    <comment>Zeiss ZEN black LSM microscopy image</comment>
    <glob pattern="*.lsm"/>
  </mime-type>
  <mime-type type="application/x-leica-lif">
    <comment>Leica LAS X LIF / LOF microscopy image</comment>
    <glob pattern="*.lif"/>
    <glob pattern="*.lof"/>
  </mime-type>
  <mime-type type="application/x-nikon-nd2">
    <comment>Nikon NIS-Elements ND2 microscopy image</comment>
    <glob pattern="*.nd2"/>
  </mime-type>
  <mime-type type="application/x-olympus-fluoview">
    <comment>Olympus FluoView OIB / OIR microscopy image</comment>
    <glob pattern="*.oib"/>
    <glob pattern="*.oir"/>
  </mime-type>
  <mime-type type="application/x-imaris">
    <comment>Imaris IMS microscopy image</comment>
    <glob pattern="*.ims"/>
  </mime-type>
  <mime-type type="application/x-gatan-dm">
    <comment>Gatan DigitalMicrograph DM3 / DM4 electron microscopy image</comment>
    <glob pattern="*.dm3"/>
    <glob pattern="*.dm4"/>
  </mime-type>
</mime-info>
