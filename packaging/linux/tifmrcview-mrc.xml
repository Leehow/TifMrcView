<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-mrc">
    <comment>MRC electron microscopy image</comment>
    <glob pattern="*.mrc"/>
    <glob pattern="*.mrcs"/>
  </mime-type>
  <mime-type type="application/x-czi">
    <comment>Zeiss CZI microscopy image</comment>
    <glob pattern="*.czi"/>
    <magic priority="60">
      <match type="string" offset="0" value="ZISRAWFILE"/>
    </magic>
  </mime-type>
</mime-info>
