{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TifMrcView",
  "version": "0.5.0",
  "identifier": "com.leehow.tifmrcview",
  "build": {
    "frontendDist": "../ui",
    "beforeBundleCommand": "node scripts/build-thumbnails.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TifMrcView",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' tmvplugin: http://tmvplugin.localhost; img-src 'self' blob: data: tmvplugin: http://tmvplugin.localhost; style-src 'self' 'unsafe-inline' tmvplugin: http://tmvplugin.localhost; frame-src 'none'; connect-src ipc: http://ipc.localhost tmvplugin: http://tmvplugin.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Fast TIFF / MRC stack viewer",
    "longDescription": "TifMrcView opens multi-page TIFF, OME-TIFF, ImageJ hyperstacks and MRC files with a Z slider, channel compositing and a folder thumbnail strip.",
    "fileAssociations": [
      {
        "ext": [
          "tif",
          "tiff"
        ],
        "name": "TIFF Image",
        "description": "TIFF Image",
        "role": "Viewer",
        "mimeType": "image/tiff",
        "contentTypes": [
          "public.tiff"
        ],
        "rank": "Default"
      },
      {
        "ext": [
          "mrc",
          "mrcs"
        ],
        "name": "MRC Image",
        "description": "MRC Electron Microscopy Image",
        "role": "Viewer",
        "mimeType": "application/x-mrc",
        "rank": "Owner",
        "exportedType": {
          "identifier": "com.leehow.tifmrcview.mrc",
          "conformsTo": [
            "public.data",
            "public.image"
          ]
        }
      },
      {
        "ext": [
          "rec",
          "st",
          "map"
        ],
        "name": "MRC Image (alternate extensions)",
        "description": "MRC Electron Microscopy Image",
        "role": "Viewer",
        "mimeType": "application/x-mrc",
        "rank": "Alternate",
        "exportedType": {
          "identifier": "com.leehow.tifmrcview.mrc-alternate",
          "conformsTo": [
            "public.data",
            "public.image"
          ]
        }
      },
      {
        "ext": [
          "czi"
        ],
        "name": "Zeiss CZI Image",
        "description": "Zeiss ZEN CZI Microscopy Image",
        "role": "Viewer",
        "mimeType": "application/x-czi",
        "rank": "Alternate",
        "exportedType": {
          "identifier": "com.leehow.tifmrcview.czi",
          "conformsTo": [
            "public.data",
            "public.image"
          ]
        }
      },
      {
        "ext": [
          "lsm"
        ],
        "name": "Zeiss LSM Image",
        "description": "Zeiss ZEN black LSM Microscopy Image",
        "role": "Viewer",
        "mimeType": "application/x-zeiss-lsm",
        "rank": "Alternate",
        "exportedType": {
          "identifier": "com.leehow.tifmrcview.lsm",
          "conformsTo": [
            "public.data",
            "public.image"
          ]
        }
      },
      {
        "ext": [
          "lif",
          "lof"
        ],
        "name": "Leica LIF Image",
        "description": "Leica LAS X LIF / LOF Microscopy Image",
        "role": "Viewer",
        "mimeType": "application/x-leica-lif",
        "rank": "Alternate",
        "exportedType": {
          "identifier": "com.leehow.tifmrcview.lif",
          "conformsTo": [
            "public.data",
            "public.image"
          ]
        }
      },
      {
        "ext": [
          "nd2"
        ],
        "name": "Nikon ND2 Image",
        "description": "Nikon NIS-Elements ND2 Microscopy Image",
        "role": "Viewer",
        "mimeType": "application/x-nikon-nd2",
        "rank": "Alternate",
        "exportedType": {
          "identifier": "com.leehow.tifmrcview.nd2",
          "conformsTo": [
            "public.data",
            "public.image"
          ]
        }
      },
      {
        "ext": [
          "oib",
          "oir"
        ],
        "name": "Olympus FluoView Image",
        "description": "Olympus FluoView OIB / OIR Microscopy Image",
        "role": "Viewer",
        "mimeType": "application/x-olympus-fluoview",
        "rank": "Alternate",
        "exportedType": {
          "identifier": "com.leehow.tifmrcview.oib",
          "conformsTo": [
            "public.data",
            "public.image"
          ]
        }
      },
      {
        "ext": [
          "ims"
        ],
        "name": "Imaris Image",
        "description": "Imaris IMS Microscopy Image",
        "role": "Viewer",
        "mimeType": "application/x-imaris",
        "rank": "Alternate",
        "exportedType": {
          "identifier": "com.leehow.tifmrcview.ims",
          "conformsTo": [
            "public.data",
            "public.image"
          ]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "files": {
        "PlugIns/TmvThumbnail.appex": "target/quicklook.noindex/TmvThumbnail.appex",
        "PlugIns/TmvPreview.appex": "target/quicklook.noindex/TmvPreview.appex"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "../packaging/windows/thumbnail-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/mime/packages/tifmrcview-mrc.xml": "../packaging/linux/tifmrcview-mrc.xml",
          "/usr/share/thumbnailers/tifmrcview.thumbnailer": "../packaging/linux/tifmrcview.thumbnailer"
        },
        "postInstallScript": "../packaging/linux/postinst.sh",
        "desktopTemplate": "../packaging/linux/tifmrcview.desktop"
      },
      "rpm": {
        "files": {
          "/usr/share/mime/packages/tifmrcview-mrc.xml": "../packaging/linux/tifmrcview-mrc.xml",
          "/usr/share/thumbnailers/tifmrcview.thumbnailer": "../packaging/linux/tifmrcview.thumbnailer"
        },
        "postInstallScript": "../packaging/linux/postinst.sh",
        "desktopTemplate": "../packaging/linux/tifmrcview.desktop"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "tifmrcview"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4OTNDQ0RCMDY4RDI0N0IKUldSN0pJMEcyOHlUU0cyZVNFNDZLM3J4Yzk1L0IyeTFxUkJRM1B4SUtaejhkM0I0Y29ORDRIK1gK",
      "endpoints": [
        "https://dl.tifmrcview.com:9443/tifmrcview/latest-direct.json",
        "https://tifmrcview.com/tifmrcview/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
